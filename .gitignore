# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.env.*
!.env.example
!.env.*.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local native compilation staging
/.c/

# Disposable isolated preview browser profiles
/.impeccable/review/chrome-*/
/.impeccable/review/**/chrome-*/

# Disposable local Android build caches
/.local/gradle-home/
/.tmp/native-temp/

# Disposable builds and local verification outputs
*.apk
*.aab
*.log
/.tmp/
/.local/
/.impeccable/review/
/modules/*/android/build/
