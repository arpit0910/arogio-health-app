# Backend API URL with version prefix
EXPO_PUBLIC_API_URL=https://backend.arogio.com/api/v1
# Required for iOS native Google Sign-In. The app config derives its URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Shared WEB OAuth client ID: native Android ID tokens and browser sign-in.
# Optional explicit Web client ID, which takes precedence over GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=987857172312-fil8ani3esi0j9gsg095c6tg1utcbm2j.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=987857172312-2lpo2lomjmfde8r0kr4k9doeqnkfeb17.apps.googleusercontent.com
