    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node scripts/start-local.cjs --web",
    "start:production": "node scripts/start-local.cjs --production-api",
    "export:production": "node scripts/start-local.cjs --production-api --export --platform web --output-dir dist/web-production",
    "start:go": "expo start --go",
    "start:dev": "expo start --dev-client",
    "check": "npm run lint && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test test/*.ts",
    "android:local": "expo run:android",
    "start:local": "node scripts/start-local.cjs"
