{
  "expo": {
    "name": "Arogio Health",
    "slug": "arogio-health-app",
    "scheme": "arogiohealth",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFDFA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arogio.health"
    },
    "android": {
      "package": "com.arogio.health",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_FLOORS_CLIMBED",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.health.READ_NUTRITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-system-ui",
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "wellness",
          "sounds": [
            "./assets/sounds/water_drop.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFDFA",
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFDFA",
            "image": "./assets/android-icon-foreground.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#214F3D",
                "dark": "#214F3D"
              },
              "colorControlActivated": {
                "light": "#214F3D",
                "dark": "#214F3D"
              },
              "textColorPrimary": {
                "light": "#203E32",
                "dark": "#203E32"
              },
              "textColorPrimaryInverse": {
                "light": "#FFFDFA",
                "dark": "#FFFDFA"
              },
              "textColorSecondary": {
                "light": "#586357",
                "dark": "#586357"
              },
              "textColorSecondaryInverse": {
                "light": "#FFFDFA",
                "dark": "#FFFDFA"
              },
              "windowBackground": {
                "light": "#FFFDFA",
                "dark": "#FFFDFA"
              }
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo for your Arogio account.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-health-rationale",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-background-task",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Arogio to count steps while you use the app."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Arogio to find your city during account setup. Only your city is saved."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "74b1d2d2-f785-4933-80a9-bea41803a5fd"
      }
    }
  }
}
